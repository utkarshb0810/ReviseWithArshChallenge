class Solution {
public:
    int countDistinct(vector<int>& nums, int k, int p) {
        int n = nums.size();
        int ans = 0;
        unordered_set<string> st;
        for (int i = 0; i < n; i++) {
            int cnt = 0;
            string temp = "";
            for (int j = i; j < n; j++) {
                if (nums[j] % p == 0) {
                    cnt++;
                }
                if (cnt <= k) {
                    temp += nums[j];
                    st.insert(temp);
                }
                if (cnt > k) {
                    break;
                }
            }
        }
        return st.size();
    }
};

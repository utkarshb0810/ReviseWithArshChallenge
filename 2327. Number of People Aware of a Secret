class Solution {
public:
    int MOD = 1e9 + 7;
    int solve(int delay,int forget,int n,vector<int> &dp){
        int  val= forget;
        val -= delay;
        if(dp[n] != -1){
            return dp[n];
        }
        int j = 0;
        int sum = 0;
        while(val > 0 && n - delay - j>0){
            val--;
            sum += ((long)solve(delay,forget,n-delay-j,dp)%MOD);
            sum = sum % MOD;
            j++;
        }
        if(n-forget>0){
            dp[n] = (sum % MOD);
        }
        else{
            dp[n] = ((sum+1) % MOD);
        }
        return dp[n];
    }
    int peopleAwareOfSecret(int n, int delay, int forget) {
        vector<int> dp(n+1,-1);
        return solve(delay,forget,n,dp); 
    }
};

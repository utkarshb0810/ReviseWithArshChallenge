string printMinNumberForPattern(string s){
        string ans;
        int cnt = 0;
        int k = 0;
        for(int i=0;i<=s.size();i++){
            if(s[i] == 'I' || i == s.size()){
                int val = cnt + 1 + k;
                while(val>k){
                    ans += char(val + '0');
                    val--;
                }
                k += cnt + 1;
                cnt = 0;
            }
            else{
                cnt++;
            }
        }
        return ans;
    }

class Solution {
public:
    vector<string> findHighAccessEmployees(vector<vector<string>>& nums) {
        int n = nums.size();
        sort(nums.begin() , nums.end());
        vector<string>ans;
        unordered_map<string , int>mp;
        for(int i = 0; i < n - 2; i++){
            if(mp.find(nums[i][0]) == mp.end() && nums[i][0] == nums[i + 2][0]){
                int time1 = stoi(nums[i][1]);
                int time2 = stoi(nums[i + 2][1]);

                if(time2 - time1 < 100){
                  i++;
                  ans.push_back(nums[i][0]);
                  mp[nums[i][0]]++;
                } 
            }
        }
       return ans;
    }
};

class Solution {
public:
    void solve(int i, int sum, vector<vector<int>>& ans, vector<int>& res,
               int k, int n) {
        if (k == 0) {
            if (sum == n) {
                ans.push_back(res);
            }
            return;
        }
        if (i > 9) {
            return;
        }
        res.push_back(i);
        sum += i;
        solve(i + 1, sum, ans, res, k - 1, n);
        res.pop_back();
        sum -= i;
        solve(i + 1, sum, ans, res, k, n);
    }
    vector<vector<int>> combinationSum3(int k, int n) {
        vector<vector<int>> ans;
        vector<int> res;
        solve(1, 0, ans, res, k, n);
        return ans;
    }
};

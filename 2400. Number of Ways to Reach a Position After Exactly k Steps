class Solution {
public:
    int dp[3005][1005];
    long long MOD = 1e9+7; 
    long long int solve(int start, int end, int k, vector<vector<int>>&dp){
        if(k == 0 && start == end){
            return 1;
        }
        if(k == 0){
            return 0;
        }
        if(dp[start+1000][k] != -1){
            return dp[start+1000][k];
        }
        int n = solve(start-1, end, k-1, dp)%MOD; 
        int m = solve(start+1, end, k-1, dp)%MOD;
        dp[start+1000][k] = n+m;
        return (n+m)%MOD;
    }
    int numberOfWays(int start, int end, int k) {
        vector<vector<int>>dp(3005,vector<int>(1005,-1));
        return solve(start, end, k,dp);
    }
};

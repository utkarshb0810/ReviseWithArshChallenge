class Solution {
public:
    int minimizeSet(int d1, int d2, int uqC1, int uqC2) {
        long long low = 1;
        long long high = INT_MAX;
        int ans = INT_MAX;
        long long int lcm = ((long long)d1 * d2) / __gcd(d1, d2);
        while (low <= high) {
            int mid = low + (high - low) / 2;
            int val1 = mid - mid / d1;    
            int val2 = mid - mid / d2; 
            int temp = mid - mid / lcm;
            if (val1 >= uqC1 and val2 >= uqC2 and temp >= (uqC1 + uqC2)) {
                ans = mid;
                high = mid - 1;
            } else {
                low = mid + 1;
            }
        }
        return ans;
    }
};
